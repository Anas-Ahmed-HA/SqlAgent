# Copy to .env and fill in. .env is gitignored; never commit real values.

# The SQL MCP server the agent needs (streamable HTTP endpoint).
MCP_URL=http://localhost:5100/mcp
# Headers sent on every MCP request, as JSON, e.g. {"X-Api-Key": "<key>"}.
# Set by configuration only; the model never sees or chooses them.
MCP_HEADERS=
# MCP_CONNECT_TIMEOUT_SECONDS=30
# MCP_CALL_TIMEOUT_SECONDS=120

# Extra MCP servers, as many as you like, as one JSON object by name. Each
# adds its tools while it is up and is left out while it is down; a turn never
# waits long on one. Only `url` is required; "sql" is taken by MCP_URL.
# Restart the agent after a change.
# MCP_EXTRA_SERVERS={"charts": {"url": "http://localhost:5200/mcp"}, "docs": {"url": "http://localhost:5300/mcp", "headers": {"X-Api-Key": "<key>"}, "connect_timeout_seconds": 5, "call_timeout_seconds": 60}}

# Shortcut for the `charts` entry above (AI_MCP_Charts), used when
# MCP_EXTRA_SERVERS has none. Its tools are offered only to clients that list
# "chart" in `cards`, and the charts go out as `chart` blocks.
CHARTS_MCP_URL=http://localhost:5200/mcp
# CHARTS_MCP_HEADERS=
# CHARTS_MCP_CONNECT_TIMEOUT_SECONDS=5
# CHARTS_MCP_CALL_TIMEOUT_SECONDS=60

# Where this service listens.
AGENT_HOST=127.0.0.1
AGENT_PORT=8321

# Login and model credentials: the caller's gateway token is forwarded to
# fetch the Azure model config (token passthrough).
SHARED_API_URL=https://api.hassanallam.com
EMPLOYEE_API_URL=https://api.hassanallam.com/api/portal/Employee_Basic_Info/GetByUserhrcode
AIAPI_BASE_URL=https://aiapi.hassanallam.com
AIAPI_CHAT_MODEL=LLM_MCP
AIAPI_TIMEOUT_SECONDS=30

# Turn limits.
# AGENT_MAX_STEPS=25
# AGENT_MAX_REQUEST_SECONDS=600
# AGENT_CONTEXT_TOKEN_BUDGET=200000
# AGENT_MAX_HISTORY_MESSAGES=40

# Questions the assistant asks mid-reply (the ask_user tool). Waiting for an
# answer does not count against AGENT_MAX_REQUEST_SECONDS.
# AGENT_MAX_QUESTIONS_PER_ASK=4
# AGENT_MAX_ASKS_PER_TURN=3
# AGENT_MAX_QUESTIONS_PER_TURN=8
# AGENT_QUESTION_WAIT_SECONDS=600
# AGENT_QUESTION_RECONNECT_SECONDS=30

# Skills each turn may bring.
# AGENT_MAX_EQUIPPED_SKILLS=16
# AGENT_MAX_EQUIPPED_SKILL_WORDS=4000

# Other web pages allowed to open the live-events WebSocket, as one regular
# expression matched against the whole Origin, e.g.
# https://([a-z0-9-]+\.)*example\.com . The chat page this service serves at /
# is always allowed; unset, no other page may. Clients that are not browsers
# send no Origin and are not affected.
# AGENT_ALLOWED_ORIGINS_REGEX=

LOG_LEVEL=INFO
